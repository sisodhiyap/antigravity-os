# ==============================================================================
# ANTIGRAVITY OS — NEXT.JS 15 DASHBOARD ENVIRONMENT CONFIGURATION
# ==============================================================================

# NEXT.JS SERVER CONFIG
PORT=3000
NODE_ENV=development

# LOCAL OLLAMA SERVER
NEXT_PUBLIC_OLLAMA_URL=http://127.0.0.1:11434
NEXT_PUBLIC_DEFAULT_MODEL=qwen2.5-coder:7b

# OMNIROUTE LOCAL GATEWAY
NEXT_PUBLIC_ROUTER_URL=http://127.0.0.1:8080

# SUPABASE POSTGRESQL & PRISMA
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/antigravity?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/antigravity?schema=public

# WEBSOCKET / SSE STREAMING
NEXT_PUBLIC_ENABLE_LIVE_STREAM=true
NEXT_PUBLIC_REFRESH_INTERVAL_MS=1000

# ==============================================================================
# SOVEREIGN CREATIVE STUDIO & HUGGING FACE AGENTS MCP
# ==============================================================================

# Server-Side Hugging Face Access Token
# Automatically resolved from Desktop/antikeys if left empty
HF_TOKEN=your_huggingface_access_token_here

# Sovereign Media Providers
IMAGE_PROVIDER=pollinations
AUDIO_PROVIDER=huggingface
VIDEO_PROVIDER=native-engine

# Cloudinary Sovereign CDN Storage (Server-Side)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://apiKey:apiSecret@cloudName
