datasource db {
  provider = "sqlite"
  url      = "file:./production.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String?
  passwordSalt   String?
  failedAttempts Int             @default(0)
  lockedUntil    DateTime?
  mfaEnabled     Boolean         @default(false)
  mfaSecret      String?
  role           String          @default("USER") // OWNER, ADMIN, MEMBER, VIEWER
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relations
  sessions       Session[]
  memberships    ProjectMember[]
  auditLogs      AuditLog[]
  jobs           GenerationJob[]
  assets         Asset[]
  conversations  AIConversation[]
  todos          Todo[]
  notes          Note[]
  memories       PersonalMemory[]
  intelligenceConversations IntelligenceConversation[]
  intelligenceTasks         IntelligenceTask[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
}

model Project {
  id             String          @id @default(uuid())
  name           String
  description    String?
  brief          String?         // The full creative brief entered by the user
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relations
  members        ProjectMember[]
  jobs           GenerationJob[]
  assets         Asset[]
  conversations  AIConversation[]
  research       ResearchRecord?
  designSystem   DesignSystem?
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model AIConversation {
  id        String      @id @default(uuid())
  projectId String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // user, assistant
  content        String
  createdAt      DateTime       @default(now())
  
  // Provenance metadata
  provider       String?
  model          String?
  latencyMs      Int?
  isError        Boolean        @default(false)

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  jobId         String            @id @default(uuid())
  userId        String
  projectId     String
  capability    String            // TEXT, IMAGE, AUDIO, VIDEO, 3D, CODE
  provider      String
  model         String
  status        String            // QUEUED, RUNNING, VALIDATING, COMPLETED, FAILED
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  executionMode String            // LIVE, LOCAL, FALLBACK
  errorCode     String?
  errorMessage  String?
  
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  result        GenerationResult?
}

model GenerationResult {
  id            String        @id @default(uuid())
  jobId         String        @unique
  assetId       String        @unique
  outputPayload String        // JSON string of output details
  createdAt     DateTime      @default(now())

  job           GenerationJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  asset         Asset         @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
}

model Asset {
  assetId        String             @id @default(uuid())
  projectId      String
  ownerId        String
  type           String             // IMAGE, AUDIO, VIDEO, 3D
  mimeType       String
  format         String             // SVG, WAV, WEBM, GLTF
  sizeBytes      Int
  hashSha256     String             @unique
  path           String
  prompt         String?
  altText        String?
  executionMode  String
  createdAt      DateTime           @default(now())
  generationJobId String?           
  
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  result         GenerationResult?
  versions       AssetVersion[]
}

model AssetVersion {
  id             String   @id @default(uuid())
  assetId        String
  versionNumber  Int
  hashSha256     String
  path           String
  createdAt      DateTime @default(now())

  asset          Asset    @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
}

model ProviderHealth {
  providerId    String   @id
  name          String
  category      String
  executionMode String
  healthState   String   // HEALTHY, DEGRADED, UNAVAILABLE
  lastVerified  DateTime @default(now())
}

model UsageEvent {
  id             String   @id @default(uuid())
  userId         String
  projectId      String
  capability     String
  provider       String
  model          String
  tokensUsed     Int      @default(0)
  estimatedCost  Float    @default(0.0)
  timestamp      DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // LOGIN, PROJECT_CREATED, ASSET_CREATED, etc.
  entityType  String
  entityId    String?
  actorId     String?
  ipAddress   String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DesignSystem {
  id        String   @id @default(uuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokens    DesignToken[]
}

model DesignToken {
  id             String       @id @default(uuid())
  designSystemId String
  category       String       // COLOR, TYPOGRAPHY, SPACING, RADIUS
  name           String
  value          String
  
  designSystem   DesignSystem @relation(fields: [designSystemId], references: [id], onDelete: Cascade)
}

model ResearchRecord {
  id           String   @id @default(uuid())
  projectId    String   @unique
  question     String?
  findingsText String?  // Persisted research synthesis / findings
  strategyText String?  // Persisted strategy & positioning document
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  filePath  String?  // Attachment file path
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// PERSONAL INTELLIGENCE V1 — SOVEREIGN COMPANION & MEMORY FABRIC
// ─────────────────────────────────────────────────────────────────────────────

model PersonalMemory {
  id              String    @id @default(uuid())
  userId          String
  category        String    // PREFERENCE, PROJECT, TECHNICAL, DECISION, WORKFLOW, TEMPORARY
  content         String
  summary         String
  sourceType      String    // USER_EXPLICIT, AGENT_OBSERVED, TASK_RESULT, TOOL_OUTPUT
  sourceReference String?
  confidence      Float     @default(1.0)
  importance      Int       @default(3) // 1 to 5
  pinned          Boolean   @default(false)
  userConfirmed   Boolean   @default(false)
  sensitivity     String    @default("PRIVATE") // PUBLIC, INTERNAL, PRIVATE, RESTRICTED
  expiresAt       DateTime?
  lastAccessedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntelligenceConversation {
  id              String                @id @default(uuid())
  userId          String
  title           String
  projectId       String?
  privacyLevel    String                @default("LOCAL_PREFERRED") // LOCAL_ONLY, LOCAL_PREFERRED, CLOUD_PERMITTED, ASK_EVERY_TIME
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        IntelligenceMessage[]
  tasks           IntelligenceTask[]
}

model IntelligenceMessage {
  id              String                   @id @default(uuid())
  conversationId  String
  role            String                   // user, assistant, system
  content         String
  provider        String?
  model           String?
  latencyMs       Int?
  isLocal         Boolean                  @default(false)
  isFallback      Boolean                  @default(false)
  fallbackReason  String?
  toolCallsJson   String?                  // JSON serialized tool call history & results
  evidenceIdsJson String?                  // JSON serialized references to evidence ledger
  createdAt       DateTime                 @default(now())

  conversation    IntelligenceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model IntelligenceTask {
  id              String                    @id @default(uuid())
  conversationId  String?
  userId          String
  title           String
  description     String
  status          String                    @default("PROPOSED") // PROPOSED, AWAITING_APPROVAL, APPROVED, RUNNING, VERIFYING, COMPLETED, FAILED, CANCELLED
  autonomyLevel   Int                       @default(2)
  privacyLevel    String                    @default("LOCAL_PREFERRED")
  planJson        String?                   // JSON DAG
  toolsCalledJson String?                   // JSON trace
  evidenceHash    String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    IntelligenceConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  approvals       IntelligenceApproval[]
}

model IntelligenceApproval {
  id              String            @id @default(uuid())
  taskId          String
  userId          String
  actionType      String            // FILE_WRITE, CODE_PATCH, SHELL_EXEC, DB_MUTATION, CLOUD_UPLOAD, PACKAGE_INSTALL
  targetResource  String
  description     String
  status          String            @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  riskLevel       String            @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  decisionBy      String?
  decisionAt      DateTime?
  createdAt       DateTime          @default(now())

  task            IntelligenceTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model IntelligenceScheduledTask {
  id              String            @id @default(uuid())
  userId          String
  title           String
  taskType        String            // DAILY_PROJECT_SUMMARY, READONLY_HEALTH_CHECK, REGRESSION_TEST_REVIEW, MODEL_AVAILABILITY_CHECK
  cronSchedule    String            // standard 5-part cron or descriptive interval
  enabled         Boolean           @default(true)
  privacyLevel    String            @default("LOCAL_ONLY")
  lastRunAt       DateTime?
  lastStatus      String?           // SUCCESS, FAILED, SKIPPED
  lastOutput      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}


